Network:
    ServerService: "0.0.0.0:{{ dist_user.Roles.miscsvr.Port | default(Roles.miscsvr.Port, true) }}"

Control:
    # 用于监听 UDP 控制指令, 这个端口只能通过防火墙指定 ip 来访问
    Service: "127.0.0.1:{{ dist_user.Roles.miscsvr.CtrlPort | default(Roles.miscsvr.CtrlPort, true) }}"
    # 加密密钥
    ScrtKey: "9WepkO@WlcYex&wW"

Redis:
    # 在线 redis
    Online:
        AddrList: {{ Redis.Online.AddrList or Redis.AddrList }}
        Passwd: "{{ Redis.Online.Passwd or Redis.Passwd }}"
        DB: {{ Redis.Online.DB if Redis.Online.DB is integer else Redis.DB }}
        MinIdleConns: 10
        # 提前加载脚本
        Scripts:
            onlineCheck: "../../redislua/checkOnline.lua"
            offline: "../../redislua/offline.lua"

RedisKey:
    OnlineKey: "{{ RedisKey.OnlineKey }}"

Common:
    GameId: {{ Common.GameId }}
    EnvName: {{ Common.EnvName }}
    # 服务正式上线的时间
    StartService: "2023-01-01"
    # 服务 id, 同一类型的服务 id 不能一样, 否则启动会失败
    ServiceId: {{ dist_user.Roles.miscsvr.ServiceId | default(Roles.miscsvr.ServiceId, true) }}
    NetLog: {{ Common.NetLog }}
    # 健康检查端口
    HealthPort: {{ dist_user.Roles.miscsvr.HealthPort | default(Roles.miscsvr.HealthPort, true) }}

Misc:
    # 单次批量处理最大数量
    MaxBatCount: 64
    # 批量处理超时时间, 单位: 毫秒
    TimeOut: 5000
    # 获取服务列表时间, 单位: 毫秒
    GetServiceTime: 3000

Locationing:
    # 默认位置信息 [AF]非洲, [EU]欧洲, [AS]亚洲, [OA]大洋洲, [NA]北美洲, [SA]南美洲, [AN]南极洲
    DefaultLocation: "{{ Locationing.DefaultLocation }}"
