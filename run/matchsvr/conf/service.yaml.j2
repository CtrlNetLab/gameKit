Network:
    ServerService: "0.0.0.0:{{ dist_user.Roles.matchsvr.Port | default(Roles.matchsvr.Port, true) }}"

Control:
    # 用于监听 UDP 控制指令, 这个端口只能通过防火墙指定 ip 来访问
    Service: "127.0.0.1:{{ dist_user.Roles.matchsvr.CtrlPort | default(Roles.matchsvr.CtrlPort, true) }}"
    # 加密密钥
    ScrtKey: "9WepkO@WlcYex&wW"

Common:
    GameId: {{ Common.GameId }}
    EnvName: {{ Common.EnvName }}
    # 链接超时时间，长时间没收到消息之后就断开连接，单位: 秒
    ConnTimeOut: 300
    # 服务 id, 同一类型的服务 id 不能一样, 否则启动会失败
    ServiceId: {{ dist_user.Roles.matchsvr.ServiceId | default(Roles.matchsvr.ServiceId, true) }}
    # 服务正式上线的时间
    StartService: "2023-01-01"
    # 心跳包超时时间，单位: 毫秒
    HeartTimeOut: 2000
    # 几次心跳包超时之后就认为连接已经断开，需要重连
    MaxHeartNum: 3
    # 服务重连时间，单位: 毫秒
    ReConnTm: 3000
    # 重连次数, -1: 表示无限次重连
    ReConnNum: -1
    NetLog: {{ Common.NetLog }}
    # 房间心跳时间, 单位: 秒
    RoomHeartTime: 30
    # 房间离线时间, 单位: 秒
    RoomOfflineTime: 60
    # 房间清理时间, 单位: 秒
    RoomClearTime: 120
    # 最大匹配数
    MaxMatchNum: 1000
    # 断开匹配取消时间, 单位: 毫秒
    DiscCancelTime: 5000

DivRule:
    # 初始分段范围
    InitDivRange: 100
    # 超时时间, 单位: 毫秒
    Timeout: 5000
    # 超时后分段范围
    TimeoutDivRange: [200, 500, 1000]
    # 是否开启固定匹配
    OpenFixMatch: false
