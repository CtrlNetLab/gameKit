# ===============================
# 脚手架例外: 以下生成物需要入库, 保证 clone 后可编译/可运行
# ===============================
# 协议生成代码(修改 proto 后重新生成, git 会显示 diff, 属正常;
# 如遵循原项目"生成物不入库"惯例, 删除本段例外并在 CI 中执行 protocol/convert.sh)
!pkg/cs/*.pb.go
!pkg/ss/*.pb.go
!pkg/database/*.pb.go
!pkg/game_third/*.pb.go
!pkg/oss/*.pb.go
!pkg/opt/scommon/*.pb.go
!pkg/configs/*.go
# 示例配置表数据(binconf)
!run/binconf/configs/ConfigInitArgsConfig.json
!run/binconf/configs/ConfigInitArgsConfig.bytes
!run/binconf/configs/WordsConfig.json
!run/binconf/configs/WordsConfig.bytes
# 示例配置表 proto(配置表管线的模板, 新增配置表时参考)
!protocol/configs/ConfigInitArgsConfig.proto
!protocol/configs/WordsConfig.proto
# buildInfo 占位(未执行 make buildInfo 时保证 control 包可编译)
!src/base/control/build.go
# win 目录调试截图
!win/img/*.png
